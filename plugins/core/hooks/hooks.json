{
  "description": "Runs rustfmt on each Rust file Claude edits, using the edition from the nearest Cargo.toml.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/rustfmt-edited.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
