{
  "description": "Runs cargo fmt after edits in Rust projects.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "test -f Cargo.toml && cargo fmt --quiet 2>/dev/null; true",
            "async": true
          }
        ]
      }
    ]
  }
}
