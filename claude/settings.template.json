{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/projects/privat/ai-config && git status --porcelain | grep -q . && echo '{\"systemMessage\": \"ai-config has uncommitted changes — run /core:sync to save your learnings.\"}' || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ssh-add -l >/dev/null 2>&1 && (cd ~/projects/privat/ai-config && git pull --ff-only --quiet) || echo '[SessionStart] No SSH agent — skipping ai-config sync'",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "core@ai-config": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "pause@ai-config": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "ai-config": {
      "source": {
        "source": "github",
        "repo": "tellewsen/ai-config"
      },
      "autoUpdate": true
    }
  }
}
