{
  "env": {
    "AI_CONFIG_DIR": "(set by install.sh / install.ps1)"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$AI_CONFIG_DIR\" ] && git -C \"$AI_CONFIG_DIR\" status --porcelain | grep -q . && echo '{\"systemMessage\": \"ai-config has uncommitted changes — run /core:sync to save your learnings.\"}' || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$AI_CONFIG_DIR\" ] || exit 0; if ssh-add -l >/dev/null 2>&1; then git -C \"$AI_CONFIG_DIR\" pull --ff-only --quiet; else echo '[SessionStart] No SSH agent — skipping ai-config sync'; fi",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "core@ai-config": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "pause@ai-config": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "ai-config": {
      "source": {
        "source": "github",
        "repo": "tellewsen/ai-config"
      },
      "autoUpdate": true
    }
  }
}
